# Copy to .env and restart the server.
#
# Google sign-in for the admin at /admin.
#
# GOOGLE_CLIENT_ID is the "Web application" OAuth client ID from
# Google Cloud Console -> APIs & Services -> Credentials. It is a public
# identifier, not a secret: this build uses the ID-token flow, so there is no
# client secret to store anywhere.
#
# Authorised JavaScript origins to add on that client:
#   http://localhost:5173     (npm run dev)
#   http://localhost:3001     (npm start)
#   https://your-real-domain  (production)
GOOGLE_CLIENT_ID=

# Google accounts allowed into the admin, comma-separated. Anyone not listed is
# refused even with a valid Google login. Leave GOOGLE_CLIENT_ID blank to fall
# back to username/password sign-in instead.
ADMIN_EMAILS=

# Port for the API / production server.
PORT=3001
